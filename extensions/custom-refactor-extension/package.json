{
  "name": "custom-refactor-extension",
  "displayName": "custom-refactor-extension",
  "description": "Provides a catalog of refactorings as code actions across multiple languages.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:python",
    "onLanguage:shellscript"
  ],
  "main": "./out/extension.js",
  "contributes": {
     "commands": [
    {
      "command": "llm.generateConsolidateConditional",
      "title": "LLM: Generate Consolidate Conditional"
    },{
      "command": "llm.generateExtractConstantString",
      "title": "LLM: Generate Extract Constant (String)"
    },
    {
  "command": "llm.generateConvertIfToCase",
  "title": "LLM: Generate Convert if to case Refactor"
}
    
  ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/jscodeshift": "^17.3.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.17",
    "@types/vscode": "^1.110.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "tree-sitter-cli": "^0.20.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "jscodeshift": "^17.3.0",
    "recast": "^0.23.8",
    "tree-sitter": "^0.25.0",
    "tree-sitter-bash": "^0.25.1",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-python": "^0.25.0"
  }
}
